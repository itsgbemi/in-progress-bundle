# Workspace Environment Configuration
# Industry-standard separation of public client-side variables and private server-side secrets.

# ==========================================
# PUBLIC CLIENT-SIDE VARIABLES (Vite Frontend)
# Safe to expose in client browser bundle (prefixed with VITE_)
# ==========================================

# Primary Firebase Web Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Forms Firebase Web Configuration
VITE_FORMS_FIREBASE_API_KEY=
VITE_FORMS_FIREBASE_AUTH_DOMAIN=
VITE_FORMS_FIREBASE_PROJECT_ID=
VITE_FORMS_FIREBASE_STORAGE_BUCKET=
VITE_FORMS_FIREBASE_MESSAGING_SENDER_ID=
VITE_FORMS_FIREBASE_APP_ID=

# Cloudinary Public Config
VITE_CLOUDINARY_CLOUD_NAME=

# ==========================================
# PRIVATE SERVER-SIDE SECRETS (Node.js / Express Backend)
# DO NOT prefix with VITE_ to prevent leakage into client JavaScript bundles!
# ==========================================

# SMTP Email Notification Credentials
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Cloudinary Admin & Signed API Credentials
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GitHub Service & OAuth Token Credentials
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_REPO_BRANCH=
GITHUB_TOKEN=
